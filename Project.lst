 00000116  B8 00000018		    mov     eax, TEMPS_PER_DAY
 0000011B  48			    dec     eax                 ; EAX = 23
 0000011C  BB 00000004		    mov     ebx, 4              ; Each SDWORD element is 4 bytes
 00000121  F7 E3		    mul     ebx                 ; EAX = 23 * 4 = 92
				    
 00000123  03 F0		    add     esi, eax            ; ESI now points directly to the last element
 00000125  B9 00000018		    mov     ecx, TEMPS_PER_DAY  ; Set loop counter to 24

 0000012A			_reverseLoop:
				    ; Register Indirect addressing to fetch and print the signed integer
 0000012A  8B 06		    mov     eax, [esi]
