 0000011B  83 7D F4 01		    cmp     negativeFlag, 1
 0000011F  75 02		    jne     _storeElement
 00000121  F7 DB		    neg     ebx

 00000123			_storeElement:
 00000123  5E			    pop     esi                 ; Restore fileBuffer pointer
 00000124  5F			    pop     edi                 ; Restore tempArray pointer
				    
