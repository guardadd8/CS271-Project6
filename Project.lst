 0000008E			ParseTempsFromString PROC
				    LOCAL   charBuffer[8]:BYTE, negativeFlag:DWORD
 0000008E  55		   *	    push   ebp
 0000008F  8B EC	   *	    mov    ebp, esp
 00000091  83 C4 F4	   *	    add    esp, 0FFFFFFF4h
 00000094  60			    pushad

 00000095  8B 75 0C		    mov     esi, [ebp + 12]     ; ESI = pointer to fileBuffer string
 00000098  8B 7D 08		    mov     edi, [ebp + 8]      ; EDI = pointer to tempArray destination
				    
 0000009B  B9 00000018		    mov     ecx, TEMPS_PER_DAY  ; Counter loop for exactly 24 elements

 000000A0			_collectLoop:
				    ; Set up destination pointer to our local temporary buffer manually without LEA
 000000A0  8B D5		    mov     edx, ebp
 000000A2  83 EA 08		    sub     edx, 8              ; EDX = pointer to start of charBuffer local variable
				    
 000000A5  57			    push    edi                 ; Save tempArray pointer while we use EDI
 000000A6  8B FA		    mov     edi, edx            ; EDI now points to our local charBuffer
 000000A8  FC			    cld                         ; Clear direction flag for string operations

 000000A9			_readChar:
 000000A9  AC			    lodsb                       ; Load byte from [ESI] into AL, advances ESI
 000000AA  3C 2C		    cmp     al, DELIMITER       ; Comma reached?
 000000AC  74 0F		    je      _endOfToken
 000000AE  3C 0D		    cmp     al, 13              ; Carriage Return reached?
 000000B0  74 0B		    je      _endOfToken
 000000B2  3C 0A		    cmp     al, 10              ; Skip line-feeds
 000000B4  74 F3		    je      _readChar
 000000B6  3C 00		    cmp     al, 0               ; End of file string?
 000000B8  74 03		    je      _endOfToken

 000000BA  AA			    stosb                       ; Store character from AL into local charBuffer
 000000BB  EB EC		    jmp     _readChar

 000000BD			_endOfToken:
 000000BD  B0 00		    mov     al, 0
 000000BF  AA			    stosb                       ; Null-terminate our local substring

				    ; --- Convert the string chunk inside charBuffer to an Integer ---
 000000C0  56			    push    esi                 ; Preserve main file string pointer
 000000C1  8B F2		    mov     esi, edx            ; ESI points to the start of charBuffer
				    
 000000C3  C7 45 F4		    mov     negativeFlag, 0     ; Reset our local sign tracker
	   00000000
 000000CA  BB 00000000		    mov     ebx, 0              ; EBX will act as our accumulating total

 000000CF  AC			    lodsb                       ; Load first character of the number
 000000D0  3C 2D		    cmp     al, '-'
 000000D2  75 08		    jne     _calculateDigit
 000000D4  C7 45 F4		    mov     negativeFlag, 1     ; Number is negative, toggle flag
	   00000001
 000000DB  AC			    lodsb                       ; Fetch the next byte (the actual first digit)

 000000DC			_calculateDigit:
 000000DC  2C 30		    sub     al, '0'             ; Convert ASCII character to literal value
				    
				    ; Simple multi-digit accumulation without 3-operand instructions
				    ; total = total * 10
 000000DE  50			    push    eax                 ; Save our current digit
 000000DF  8B C3		    mov     eax, ebx
 000000E1  BA 0000000A		    mov     edx, 10
 000000E6  F7 EA		    imul    edx                 ; EAX = EAX * 10
 000000E8  8B D8		    mov     ebx, eax            ; Put total back into EBX
 000000EA  58			    pop     eax                 ; Restore our digit

				    ; total = total + current_digit
 000000EB  BA 00000000		    mov     edx, 0              ; Clear EDX manually
 000000F0  8A D0		    mov     dl, al              ; Safely move byte to register without movzx
 000000F2  03 DA		    add     ebx, edx            ; Add digit to running total

 000000F4  AC			    lodsb                       ; Fetch next character
 000000F5  3C 00		    cmp     al, 0               ; Process until our null terminator
 000000F7  75 E3		    jne     _calculateDigit

				    ; Apply negative sign if flag was set
 000000F9  83 7D F4 01		    cmp     negativeFlag, 1
 000000FD  75 02		    jne     _finishStorage
 000000FF  F7 DB		    neg     ebx

 00000101			_finishStorage:
 00000101  5E			    pop     esi                 ; Restore fileBuffer source pointer
 00000102  5F			    pop     edi                 ; Restore tempArray destination pointer
				    
 00000103  89 1F		    mov     [edi], ebx          ; Store 32-bit SDWORD into array
 00000105  83 C7 04		    add     edi, TYPE tempArray ; Move to next SDWORD position (adds 4)
				    
 00000108  E2 96		    loop    _collectLoop        ; Loop until all 24 integers are populated

