 000000ED			_calculateDigit:
 000000ED  2C 30		    sub     al, '0'             ; Convert ASCII character to literal value
				    
				    ; Simple multi-digit accumulation without 3-operand instructions
				    ; total = total * 10
 000000EF  50			    push    eax                 ; Save our current digit
 000000F0  8B C3		    mov     eax, ebx
 000000F2  BA 0000000A		    mov     edx, 10
