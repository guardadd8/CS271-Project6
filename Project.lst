				; ---------------------------------------------------------------------------------
				; Name: WriteTempsReverse
				;
				; Traverses a signed integer array backwards (from last element) and displays
				; each temperature value followed by a comma delimiter, on the console.
				;
				; Preconditions: tempArray must have TEMPS_PER_DAY populated elements.
				;
				; Receives:
				;   [ebp + 8]  = address of tempArray
				; ---------------------------------------------------------------------------------
 00000131			WriteTempsReverse PROC
 00000131  55			    push    ebp
 00000132  8B EC		    mov     ebp, esp
 00000134  60			    pushad

 00000135  8B 75 08		    mov     esi, [ebp + 8]      ; tempArray
				    
				    ; Get memory offset (23*4) for last index element
 00000138  B8 00000018		    mov     eax, TEMPS_PER_DAY
 0000013D  48			    dec     eax
 0000013E  BB 00000004		    mov     ebx, 4
 00000143  F7 E3		    mul     ebx
				    
 00000145  03 F0		    add     esi, eax            ; ESI points to last element
 00000147  B9 00000018		    mov     ecx, TEMPS_PER_DAY  ; Set item counter

 0000014C			_reverseLoop:
				    ; Acquire and print the signed integer with delimiter
 0000014C  8B 06		    mov     eax, [esi]
 0000014E  E8 00000000 E	    call    WriteInt
				    mDisplayChar DELIMITER
 00000153  50		     1	    push	eax
 00000154  B0 2C	     1	    mov		al, DELIMITER
 00000156  E8 00000000 E     1	    call	WriteChar
 0000015B  58		     1	    pop		eax
 0000015C  83 EE 04		    sub     esi, 4              ; Move backwards to next SDWORD element
 0000015F  E2 EB		    loop    _reverseLoop        ; Loop until all elements are done

 00000161  E8 00000000 E	    call    CrLf                ; Move to next line after output line completion
				    
 00000166  61			    popad
 00000167  5D			    pop     ebp
 00000168  C2 0004		    ret     4
 0000016B			WriteTempsReverse ENDP

