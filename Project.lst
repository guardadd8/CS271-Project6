 000000A0			ParseTempsFromString PROC
 000000A0  55			    push    ebp
 000000A1  8B EC		    mov     ebp, esp
 000000A3  60			    pushad

 000000A4  8B 75 0C		    mov     esi, [ebp + 12]     ; esi = pointer to fileBuffer string
 000000A7  8B 7D 08		    mov     edi, [ebp + 8]      ; edi = pointer to tempArray destination
				    
 000000AA  B9 00000000		    mov     ecx, 0              ; ecx will act as our running integer total
 000000AF  B3 00		    mov     bl, 0               ; bl will track negative flag (0 = positive, 1 = negative)
 000000B1  B7 00		    mov     bh, 0               ; bh will track if we processed any digits for this number (0 = no, 1 = yes)

 000000B3			_parseLoop:
 000000B3  8A 06		    mov     al, [esi]           ; Grab current character
 000000B5  46			    inc     esi                 ; Move pointer forward for next round
				    
 000000B6  3C 00		    cmp     al, 0               ; Check for null terminator (end of file string)
 000000B8  74 40		    je      _saveFinal
 000000BA  3C 2C		    cmp     al, DELIMITER       ; Check for comma
 000000BC  74 22		    je      _saveValue
 000000BE  3C 0D		    cmp     al, 13              ; Check for Carriage Return (end of line)
 000000C0  74 1E		    je      _saveValue
 000000C2  3C 0A		    cmp     al, 10              ; Check for Line Feed
 000000C4  74 ED		    je      _parseLoop          ; Skip line feed, move to next character

 000000C6  3C 2B		    cmp     al, '+'             ; Is it an explicit plus sign?
 000000C8  74 E9		    je      _parseLoop          ; Just skip it and move to the numbers
				    
 000000CA  3C 2D		    cmp     al, '-'             ; Is it a negative sign?
 000000CC  75 04		    jne     _isDigit
 000000CE  B3 01		    mov     bl, 1               ; Set negative flag to true
 000000D0  EB E1		    jmp     _parseLoop

 000000D2			_isDigit:
 000000D2  2C 30		    sub     al, '0'             ; Convert ASCII character to literal integer value
 000000D4  0F B6 C0		    movzx   eax, al
				    
 000000D7  B7 01		    mov     bh, 1               ; Explicitly flag that we have processed a valid digit
				    ; Multi-digit math: total = (total * 10) + new_digit
 000000D9  6B C9 0A		    imul    ecx, ecx, 10
 000000DC  03 C8		    add     ecx, eax
 000000DE  EB D3		    jmp     _parseLoop

 000000E0			_saveValue:
				    ; If we haven't seen any actual digits yet, don't save anything
 000000E0  80 FF 00		    cmp     bh, 0
 000000E3  74 0A		    je      _resetFlags

				    ; Check if negative flag was set
 000000E5  80 FB 01		    cmp     bl, 1
 000000E8  75 02		    jne     _store
 000000EA  F7 D9		    neg     ecx                 ; Negate the value if it was marked negative

 000000EC			_store:
 000000EC  88 0F		    mov     [edi], cl           ; Store the lower byte into tempArray
 000000EE  47			    inc     edi                 ; Move to next byte slot in array

 000000EF			_resetFlags:
 000000EF  B9 00000000		    mov     ecx, 0              ; Reset total accumulator
 000000F4  B3 00		    mov     bl, 0               ; Reset negative flag
 000000F6  B7 00		    mov     bh, 0               ; Reset digit validation tracker
 000000F8  EB B9		    jmp     _parseLoop

 000000FA			_saveFinal:
				    ; Catch any trailing numbers that didn't end with a delimiter
 000000FA  80 FF 00		    cmp     bh, 0
 000000FD  74 09		    je      _done
 000000FF  80 FB 01		    cmp     bl, 1
 00000102  75 02		    jne     _storeFinal
 00000104  F7 D9		    neg     ecx
 00000106			_storeFinal:
 00000106  88 0F		    mov     [edi], cl

 00000108			_done:
 00000108  61			    popad
 00000109  5D			    pop     ebp
 0000010A  C2 0008		    ret     8
 0000010D			ParseTempsFromString ENDP

