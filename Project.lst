				; ---------------------------------------------------------------------------------
				; Name: ParseTempsFromString
				;
				; Parses ASCII data string from a text file buffer, extracts numerical 
				; digit characters separated by delimiters, and converts them into signed
				; integers stored sequentially within destination array.
				;
				; Preconditions:    fileBuffer must contain valid null-terminated string of data.
				;                   tempArray must hold at least TEMPS_PER_DAY elements.
				;
				; Receives:
				;   [ebp + 12] = address of text-contents buffer
				;   [ebp + 8]  = address of destination array
				;
				; Returns:
				;   tempArray  = holds converted signed integer values
				; ---------------------------------------------------------------------------------
 000000B0			ParseTempsFromString PROC
				    LOCAL   charBuffer[8]:BYTE, negativeFlag:DWORD
 000000B0  55		   *	    push   ebp
 000000B1  8B EC	   *	    mov    ebp, esp
 000000B3  83 C4 F4	   *	    add    esp, 0FFFFFFF4h
 000000B6  60			    pushad

 000000B7  8B 75 0C		    mov     esi, [ebp + 12]     ; fileBuffer
 000000BA  8B 7D 08		    mov     edi, [ebp + 8]      ; tempArray
 000000BD  B9 00000018		    mov     ecx, TEMPS_PER_DAY  

 000000C2			_collectLoop:
				    ; Set pointer to charBuffer. 
 000000C2  8B D5		    mov     edx, ebp
 000000C4  83 EA 08		    sub     edx, 8              ; Point to charBuffer
 000000C7  57			    push    edi                 ; Preserve tempArray pointer and point EDI to charBuffer
 000000C8  8B FA		    mov     edi, edx            
 000000CA  FC			    cld                         

 000000CB			_readChar:
				    ; Check if comma, carriage return, line-feed, or end of string is reached and properly deal with them.
 000000CB  AC			    lodsb                       
 000000CC  3C 2C		    cmp     al, DELIMITER       ; Check if comma reached
 000000CE  74 0F		    je      _endOfToken
 000000D0  3C 0D		    cmp     al, 13              ; Check for carriage return
 000000D2  74 0B		    je      _endOfToken
 000000D4  3C 0A		    cmp     al, 10              ; Check and skip line-feeds
 000000D6  74 F3		    je      _readChar
 000000D8  3C 00		    cmp     al, 0               ; Check if end of string
 000000DA  74 03		    je      _endOfToken
 000000DC  AA			    stosb                       ; Store AL character in charBuffer
 000000DD  EB EC		    jmp     _readChar

 000000DF			_endOfToken:
 000000DF  B0 00		    mov     al, 0
 000000E1  AA			    stosb                       ; Null-terminate substring

				    ; Convert substring in charBuffer to integer
 000000E2  56			    push    esi                 
 000000E3  8B F2		    mov     esi, edx            ; Point ESI to charBuffer
				    
 000000E5  C7 45 F4		    mov     negativeFlag, 0     ; Reset local sign tracker
	   00000000
 000000EC  BB 00000000		    mov     ebx, 0              ; Accumulator

 000000F1  AC			    lodsb                       
 000000F2  3C 2D		    cmp     al, '-'
 000000F4  75 08		    jne     _calculateDigit
 000000F6  C7 45 F4		    mov     negativeFlag, 1     ; Toggle flag if negative number
	   00000001
 000000FD  AC			    lodsb                       ; Get first digit in substring

 000000FE			_calculateDigit:
 000000FE  2C 30		    sub     al, '0'             ; Convert ASCII character to literal value
				    
				    ; Perform multi-digit accumulation, total = (total * 10) + current_digit
 00000100  50			    push    eax                 
 00000101  8B C3		    mov     eax, ebx
 00000103  BA 0000000A		    mov     edx, 10
 00000108  F7 EA		    imul    edx                 
 0000010A  8B D8		    mov     ebx, eax            
 0000010C  58			    pop     eax                 

 0000010D  BA 00000000		    mov     edx, 0              
 00000112  8A D0		    mov     dl, al              ; Move byte to register
 00000114  03 DA		    add     ebx, edx            ; Add digit to current total

 00000116  AC			    lodsb                       
 00000117  3C 00		    cmp     al, 0               ; Process until null terminator
 00000119  75 E3		    jne     _calculateDigit

